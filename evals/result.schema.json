{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "questor/evals/result/v1.json",
  "title": "QuestorEvalResult",
  "description": "对照评测结果记录（字段移植自 wuu evals/result.schema.json，2026-10-11 实测；case 增 pillar 列）。results/ 目录内每个 <run-id>/ 一份，被公开引用后不可变。",
  "type": "object",
  "required": [
    "schema_version", "id", "title", "case", "run", "environment",
    "models", "outcome", "metrics", "artifacts", "disclosure", "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "case": {
      "type": "object",
      "required": ["id", "pillar", "prompt_artifact"],
      "properties": {
        "id": { "type": "string" },
        "pillar": { "type": "string", "enum": ["visible", "intervenable", "verifiable"] },
        "source": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"] },
        "source_commit": { "type": ["string", "null"] },
        "prompt_artifact": { "type": "string", "description": "artifacts 中 prompt 文件的 sha256 指针" }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["started_at", "finished_at", "command", "questor_commit", "dirty"],
      "properties": {
        "started_at": { "type": "string" },
        "finished_at": { "type": "string" },
        "command": { "type": "string" },
        "questor_version": { "type": ["string", "null"] },
        "questor_commit": { "type": ["string", "null"] },
        "dirty": { "const": false, "description": "脏构建不得发布" }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "hardware": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["provider", "model"],
        "properties": {
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "role": { "type": ["string", "null"] },
          "settings": { "type": ["object", "null"] }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "object",
      "required": ["status", "grader"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed", "error"] },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "grader": { "type": "string" },
        "failure_kind": {
          "type": ["string", "null"],
          "enum": ["compile", "logic", "test_comprehension", "budget"],
          "description": "失败四分类（failure_tax.py），语义对齐 FlowCoder"
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["duration_ms"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"] },
        "cost_source": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "kind": { "type": "string", "enum": ["prompt", "raw_report", "grader", "transcript", "fixture", "other"] }
        },
        "additionalProperties": false
      }
    },
    "disclosure": {
      "type": "object",
      "required": ["contains_secrets", "contains_personal_data", "redactions"],
      "properties": {
        "contains_secrets": { "const": false },
        "contains_personal_data": { "const": false },
        "redactions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
